# Copia a .dev.vars (local) o crea secretos con `wrangler secret put NOMBRE` (producción).
SESSION_SECRET=           # cadena aleatoria larga
QUEUE_MODE=inline         # inline (local: procesa tras responder) | queue (producción: Cloudflare Queues)
PROVIDER=mock             # mock | openai
OPENAI_API_KEY=           # solo si PROVIDER=openai (de pago)
OPENAI_IMAGE_MODEL=       # por defecto gpt-image-2; confirma el nombre vigente en la documentación de OpenAI
OPENAI_IMAGE_QUALITY=     # low | medium (por defecto) | high: la calidad alta multiplica el coste
OPENAI_BASE_URL=          # solo pruebas: apunta a un servidor que imita la API (no gasta nada)
EMAIL_PROVIDER=console    # console | resend
RESEND_API_KEY=           # solo si EMAIL_PROVIDER=resend
EMAIL_FROM=Tatuaje <hola@tudominio.com>
STRIPE_SECRET_KEY=        # sk_test_... para pruebas
STRIPE_WEBHOOK_SECRET=    # whsec_...
STRIPE_AUTOMATIC_TAX=      # 1 para activar Stripe Tax (IVA) tras configurarlo en el panel de Stripe
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET=
ADMIN_EMAILS=tu@correo.com   # emails con rol admin
APP_URL=https://tudominio.com
DISABLE_ABUSE_LIMITS=     # 1 SOLO en local/pruebas: desactiva los límites de pruebas gratis por IP y dispositivo. Nunca en producción
